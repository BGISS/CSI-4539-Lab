project Lab3 is

   for Source_Dirs use ("src");
   for Object_Dir  use "obj";
   for Main        use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnata",     --  verif des contrats (pre/post, predicats) a l'exec (E3)
         "-gnatwa",    --  tous les avertissements du compilateur
         "-gnatVa",    --  toutes les verifications de validite
         "-g",
         "-O0");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=all");
   end Prove;

   package Builder is
      for Default_Switches ("Ada") use ("-g");
   end Builder;

end Lab3;
